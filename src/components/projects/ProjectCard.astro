---
// src/components/projects/ProjectCard.astro
import TagList from '../ui/TagList.astro';

interface Props {
  title: string;
  description: string;
  category: 'independent' | 'professional-case-study' | 'experiment';
  technologies: string[];
  slug?: string;
  demoUrl?: string;
  repositoryUrl?: string;
  status?: string;
  statusLabel?: string;
  problem?: string;
  role?: string;
  featured?: boolean;
}

const {
  title,
  description,
  category,
  technologies,
  slug,
  demoUrl,
  repositoryUrl,
  statusLabel,
  problem,
  role,
  featured = false,
} = Astro.props;

const categoryLabel: Record<string, string> = {
  independent: 'Independent',
  'professional-case-study': 'Case Study',
  experiment: 'Experiment',
};

const categoryColor: Record<string, string> = {
  independent: 'text-success bg-success/10 border-success/30',
  'professional-case-study': 'text-accent bg-accent/10 border-accent/30',
  experiment: 'text-warning bg-warning/10 border-warning/30',
};
---

<article
  class="group relative flex flex-col bg-surface border border-border rounded-lg p-6 hover:border-border/80 hover:bg-surface-raised transition-all duration-200"
  class:list={[featured && 'ring-1 ring-accent/20']}
>
  <!-- Badges row -->
  <div class="flex items-center justify-between gap-2 mb-3">
    <span class={`text-[0.65rem] font-mono font-medium border rounded px-2 py-0.5 leading-none ${categoryColor[category] ?? 'text-muted border-border'}`}>
      {categoryLabel[category] ?? category}
    </span>
    {statusLabel && (
      <span class="text-[0.65rem] font-mono text-subtle bg-bg border border-border/80 rounded px-2 py-0.5 leading-none">
        {statusLabel}
      </span>
    )}
  </div>

  <!-- Title -->
  <h3 class="text-base font-semibold text-text leading-snug mb-3">
    {slug ? (
      <a href={`/projects/${slug}`} class="no-underline hover:text-accent transition-colors duration-150">
        {title}
      </a>
    ) : (
      title
    )}
  </h3>

  <!-- Problem Statement (if provided) -->
  {problem ? (
    <div class="mb-3">
      <span class="text-[0.7rem] font-mono font-semibold uppercase tracking-wider text-accent/90 block mb-1">
        Problem Solved
      </span>
      <p class="text-xs text-muted leading-relaxed">
        {problem}
      </p>
    </div>
  ) : (
    <p class="text-xs text-muted leading-relaxed mb-3">
      {description}
    </p>
  )}

  <!-- Role / Contribution (if provided) -->
  {role && (
    <div class="mb-4 text-xs text-muted/80 flex items-center gap-1.5">
      <span class="text-[0.7rem] font-mono uppercase tracking-wider text-subtle font-medium">Role:</span>
      <span class="text-text font-medium">{role}</span>
    </div>
  )}

  <!-- Tech tags -->
  <div class="mb-5 flex-1">
    <TagList tags={technologies} />
  </div>

  <!-- Links -->
  <div class="flex items-center gap-4 mt-auto pt-4 border-t border-border">
    {slug && (
      <a
        href={`/projects/${slug}`}
        class="text-xs text-accent hover:text-accent-hover no-underline font-medium transition-colors duration-150 inline-flex items-center gap-1"
      >
        Read case study →
      </a>
    )}
    {demoUrl && (
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-muted hover:text-text no-underline transition-colors duration-150 inline-flex items-center gap-1"
      >
        Live demo ↗
      </a>
    )}
    {repositoryUrl && (
      <a
        href={repositoryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-muted hover:text-text no-underline transition-colors duration-150 inline-flex items-center gap-1"
      >
        Repository ↗
      </a>
    )}
  </div>
</article>
