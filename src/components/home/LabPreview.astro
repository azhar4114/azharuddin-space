---
// src/components/home/LabPreview.astro
import ButtonLink from '../ui/ButtonLink.astro';

const tools = [
  {
    name: 'JSON Formatter',
    description: 'Format and validate JSON instantly. Errors shown clearly. No data transmitted.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    href: '/lab#json-formatter',
  },
  {
    name: 'Base64 Encoder / Decoder',
    description: 'Encode or decode text with Base64. Handles Unicode correctly in the browser.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    href: '/lab#base64',
  },
  {
    name: 'Cron Expression Helper',
    description: 'Understand and compose cron expressions with field explanations and examples.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    href: '/lab#cron-helper',
  },
];
---

<section class="py-20 sm:py-24 border-t border-border">
  <div class="container-content">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10">
      <div>
        <p class="text-eyebrow mb-3">Developer Lab</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-text tracking-tight">
          Browser-based tools
        </h2>
        <p class="text-muted text-sm mt-2">All tools run entirely in your browser. Nothing is transmitted.</p>
      </div>
      <ButtonLink href="/lab" variant="ghost" size="sm">
        Open the lab →
      </ButtonLink>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group flex flex-col gap-3 p-5 bg-surface border border-border rounded-lg hover:border-accent/40 hover:bg-surface-raised transition-all duration-200 no-underline"
        >
          <div class="text-accent"  set:html={tool.icon} />
          <div>
            <h3 class="text-sm font-semibold text-text mb-1 group-hover:text-accent transition-colors duration-150">
              {tool.name}
            </h3>
            <p class="text-xs text-muted leading-relaxed">{tool.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
