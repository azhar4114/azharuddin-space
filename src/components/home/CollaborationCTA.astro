---
// src/components/home/CollaborationCTA.astro
import ButtonLink from '../ui/ButtonLink.astro';
---

<section class="py-20 sm:py-24 border-t border-border">
  <div class="container-content">
    <div class="max-w-2xl">
      <p class="text-eyebrow mb-4">Connect</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-text tracking-tight mb-4 text-balance">
        Interested in architecture or engineering discussions?
      </h2>
      <p class="text-muted text-base leading-relaxed mb-8">
        I'm always keen to exchange ideas with fellow engineers on distributed systems,
        Pega workflows, observability patterns, agentic AI coding, or educational technology.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <ButtonLink href="/contact" variant="primary" size="md">
          Get in touch
        </ButtonLink>
        <ButtonLink href="/services" variant="ghost" size="md">
          Explore capabilities
        </ButtonLink>
      </div>
    </div>
  </div>
</section>
