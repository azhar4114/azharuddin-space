---
// src/pages/experience.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import TagList from '../components/ui/TagList.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import { publicExperience, certifications, education, awards } from '../data/experience';
import { skillGroups } from '../data/skills';
import { site } from '../data/site';
---

<BaseLayout
  title="Experience"
  description="Professional career history, certifications, and technical skills of Mohammad Azharuddin — Senior Software Engineer, Integration & Observability Specialist, and Pega CSSA."
>
  <div class="container-content py-20 sm:py-28">
    <!-- Header -->
    <div class="max-w-2xl mb-16">
      <p class="text-eyebrow mb-4">Career & Track Record</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-text tracking-tight mb-4">
        Professional Experience
      </h1>
      <p class="text-muted leading-relaxed">
        Continuous software engineering, workflow orchestration, and tooling delivery experience since December 2012.
        Proven track record architecting enterprise systems, optimizing observability, and mentoring engineering teams.
      </p>
    </div>

    <!-- Certifications & Awards Quick Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
      <!-- Certifications -->
      <div class="p-6 bg-surface border border-border rounded-lg">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="7"/>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
            </svg>
          </span>
          <h2 class="text-xs font-mono font-semibold text-subtle uppercase tracking-widest">
            Certifications
          </h2>
        </div>
        <ul class="space-y-3 list-none p-0 m-0">
          {certifications.map((c) => (
            <li class="flex items-start justify-between gap-3 text-sm">
              <div>
                <span class="font-medium text-text block">{c.name}</span>
                <span class="text-xs text-subtle">{c.issuer}</span>
              </div>
              <span class={`text-[0.65rem] font-mono px-2 py-0.5 rounded border shrink-0 ${
                c.status === 'active'
                  ? 'text-success bg-success/10 border-success/30'
                  : 'text-warning bg-warning/10 border-warning/30'
              }`}>
                {c.date}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Education & Honours -->
      <div class="p-6 bg-surface border border-border rounded-lg">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </span>
          <h2 class="text-xs font-mono font-semibold text-subtle uppercase tracking-widest">
            Education & Honours
          </h2>
        </div>
        {education.map((edu) => (
          <div class="mb-4">
            <span class="font-medium text-text text-sm block">{edu.degree}</span>
            <span class="text-xs text-muted block">{edu.institution} · {edu.university}</span>
            <span class="text-xs font-mono text-accent mt-0.5 block">{edu.year} — {edu.score}</span>
          </div>
        ))}
        <div class="pt-3 border-t border-border/60">
          {awards.map((a) => (
            <div class="text-xs text-muted mb-2 last:mb-0">
              <span class="font-medium text-text">{a.title} ({a.organization}):</span> {a.description}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Timeline -->
    <section aria-label="Career timeline" class="mb-24">
      <div class="mb-10">
        <p class="text-eyebrow mb-2">History</p>
        <h2 class="text-2xl font-bold text-text tracking-tight">Career Timeline</h2>
      </div>

      <div class="flex flex-col gap-0">
        {publicExperience.map((entry, i) => (
          <div class="relative flex gap-8 pb-12 last:pb-0">
            <!-- Timeline line -->
            {i < publicExperience.length - 1 && (
              <div
                class="absolute left-[11px] top-6 bottom-0 w-px bg-border"
                aria-hidden="true"
              />
            )}

            <!-- Dot -->
            <div class="relative mt-1 shrink-0">
              <div
                class={`w-5 h-5 rounded-full border-2 flex items-center justify-center ${
                  entry.endDate === null
                    ? 'border-accent bg-accent/20'
                    : 'border-border bg-surface'
                }`}
              >
                {entry.endDate === null && (
                  <div class="w-2 h-2 rounded-full bg-accent" />
                )}
              </div>
            </div>

            <!-- Content -->
            <div class="flex-1 pb-8 border-b border-border last:border-0">
              <!-- Role + current badge -->
              <div class="flex items-start justify-between gap-4 flex-wrap mb-1">
                <h3 class="text-lg font-semibold text-text">{entry.role}</h3>
                {entry.endDate === null && (
                  <span class="text-[0.65rem] font-mono font-medium text-success bg-success/10 border border-success/30 rounded px-2 py-0.5 leading-none shrink-0">
                    Current Role
                  </span>
                )}
              </div>

              <!-- Employer & Client Assignment / period -->
              <div class="flex items-center gap-2 flex-wrap text-sm mb-1">
                <span class="font-semibold text-text">{entry.employer}</span>
                {entry.client && (
                  <span class="text-subtle font-normal">
                    · Client Assignment: <strong class="text-muted font-medium">{entry.client}</strong>
                  </span>
                )}
              </div>
              <p class="text-xs font-mono text-subtle mb-4">
                {entry.periodLabel}
              </p>

              <!-- Summary -->
              <p class="text-muted text-sm leading-relaxed mb-4">{entry.summary}</p>

              <!-- Highlights -->
              {entry.highlights.length > 0 && (
                <ul class="list-disc list-inside text-sm text-muted space-y-1.5 mb-5 pl-1">
                  {entry.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              <!-- Tech tags -->
              <TagList tags={entry.technologies} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section aria-label="Technical skills" class="mb-16">
      <div class="mb-8">
        <p class="text-eyebrow mb-3">Skills Matrix</p>
        <h2 class="text-2xl font-bold text-text tracking-tight">
          Technologies & Competencies
        </h2>
        <p class="text-subtle text-sm mt-1">
          Detailed breakdown of platforms, observability tools, scripting languages, and cloud systems.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {skillGroups.map((group) => (
          <div class="p-5 bg-surface border border-border rounded-lg">
            <h3 class="text-xs font-mono font-semibold text-subtle uppercase tracking-widest mb-4">
              {group.heading}
            </h3>
            <ul class="space-y-2 list-none p-0 m-0">
              {group.skills.map((skill) => (
                <li class="flex items-center justify-between gap-3">
                  <span class="text-sm text-text">{skill.name}</span>
                  <span
                    class={`text-[0.6rem] font-mono px-1.5 py-0.5 rounded border leading-none ${
                      skill.level === 'professional'
                        ? 'text-success border-success/40 bg-success/10'
                        : skill.level === 'working'
                        ? 'text-accent border-accent/40 bg-accent/10'
                        : 'text-warning border-warning/40 bg-warning/10'
                    }`}
                  >
                    {skill.level}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Resume CTA -->
    <div class="p-6 bg-surface border border-border rounded-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <div>
        <h3 class="text-sm font-semibold text-text mb-1">Looking for the executive resume?</h3>
        <p class="text-muted text-sm">Download the verified, one-page technical resume.</p>
      </div>
      <div class="flex items-center gap-3">
        <ButtonLink href={site.resumePath} variant="primary" size="sm" external>
          Download PDF
        </ButtonLink>
        <ButtonLink href="/contact" variant="ghost" size="sm">
          Get in touch
        </ButtonLink>
      </div>
    </div>
  </div>
</BaseLayout>
