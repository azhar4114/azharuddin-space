---
// src/components/ui/ButtonLink.astro

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
  ariaLabel,
} = Astro.props;

const baseClasses =
  'inline-flex items-center gap-2 font-medium rounded no-underline transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent';

const variantClasses = {
  primary:
    'bg-accent text-bg hover:bg-accent-hover hover:text-bg',
  secondary:
    'bg-transparent text-accent border border-accent hover:bg-accent/10 hover:text-accent-hover',
  ghost:
    'bg-transparent text-muted hover:text-text hover:bg-surface-raised border border-border',
};

const sizeClasses = {
  sm:  'px-3 py-1.5 text-xs',
  md:  'px-5 py-2.5 text-sm',
  lg:  'px-7 py-3 text-base',
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className]
  .filter(Boolean)
  .join(' ');
---

<a
  href={href}
  class={classes}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  {...ariaLabel ? { 'aria-label': ariaLabel } : {}}
>
  <slot />
</a>
