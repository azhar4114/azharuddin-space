---
// src/components/home/FeaturedProjects.astro
import { getCollection } from 'astro:content';
import ProjectCard from '../projects/ProjectCard.astro';
import ButtonLink from '../ui/ButtonLink.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => {
    const dateA = a.data.publishedAt ? new Date(a.data.publishedAt).getTime() : 0;
    const dateB = b.data.publishedAt ? new Date(b.data.publishedAt).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 4);
---

<section class="py-20 sm:py-24 border-t border-border">
  <div class="container-content">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10">
      <div>
        <p class="text-eyebrow mb-3">Selected Projects</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-text tracking-tight">
          Featured engineering projects
        </h2>
      </div>
      <ButtonLink href="/projects" variant="ghost" size="sm">
        View all projects →
      </ButtonLink>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featured.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          category={project.data.category}
          technologies={project.data.technologies}
          slug={project.slug}
          demoUrl={project.data.demoUrl}
          repositoryUrl={project.data.repositoryUrl}
          status={project.data.status}
          statusLabel={project.data.statusLabel}
          problem={project.data.problem}
          role={project.data.role}
          featured={project.data.featured}
        />
      ))}
    </div>
  </div>
</section>
