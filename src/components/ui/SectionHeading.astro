---
// src/components/ui/SectionHeading.astro

interface Props {
  eyebrow?: string;
  heading: string;
  subtitle?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
}

const {
  eyebrow,
  heading,
  subtitle,
  align = 'left',
  as: Tag = 'h2',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<div class={`flex flex-col gap-3 ${alignClass}`}>
  {eyebrow && (
    <span class="text-eyebrow">{eyebrow}</span>
  )}
  <Tag class="text-2xl sm:text-3xl font-bold text-text tracking-tight text-balance">
    {heading}
  </Tag>
  {subtitle && (
    <p class="text-muted text-base leading-relaxed max-w-2xl">
      {subtitle}
    </p>
  )}
</div>
