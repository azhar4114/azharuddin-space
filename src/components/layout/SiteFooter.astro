---
// src/components/layout/SiteFooter.astro
import { site } from '../../data/site';
import { footerLinks } from '../../data/navigation';

const year = new Date().getFullYear();
---

<footer
  class="border-t border-border mt-24"
  role="contentinfo"
>
  <div class="container-content py-16">
    <!-- Top section -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Brand column -->
      <div class="md:col-span-1">
        <a href="/" class="inline-flex items-center gap-2 no-underline mb-4" aria-label="Home">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded bg-accent text-bg font-mono font-bold text-sm" aria-hidden="true">A.</span>
          <span class="font-semibold text-text text-sm">azharuddin<span class="text-subtle">.space</span></span>
        </a>
        <p class="text-muted text-sm leading-relaxed">
          Turning ideas into useful software.
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-3 mt-5">
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile"
            class="text-subtle hover:text-accent transition-colors duration-150 no-underline"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
            </svg>
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile"
            class="text-subtle hover:text-accent transition-colors duration-150 no-underline"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          <a
            href={`mailto:${site.email}`}
            aria-label="Send email"
            class="text-subtle hover:text-accent transition-colors duration-150 no-underline"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {footerLinks.map((group) => (
        <div>
          <h3 class="text-xs font-semibold text-subtle uppercase tracking-widest mb-4 font-mono">
            {group.heading}
          </h3>
          <ul class="space-y-2.5 list-none p-0 m-0">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted hover:text-text transition-colors duration-150 no-underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-subtle text-xs font-mono">
        &copy; {year} Mohammad Azharuddin. All rights reserved.
      </p>
      <p class="text-subtle text-xs font-mono">
        Built with <a href="https://astro.build" class="text-muted hover:text-accent no-underline transition-colors" target="_blank" rel="noopener noreferrer">Astro</a> &amp; TypeScript.
      </p>
    </div>
  </div>
</footer>
