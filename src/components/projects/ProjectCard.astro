---
// src/components/projects/ProjectCard.astro
import TagList from '../ui/TagList.astro';

interface Props {
  title: string;
  description: string;
  category: 'independent' | 'professional-case-study' | 'experiment';
  technologies: string[];
  slug?: string;
  demoUrl?: string;
  repositoryUrl?: string;
  status?: string;
  featured?: boolean;
}

const {
  title,
  description,
  category,
  technologies,
  slug,
  demoUrl,
  repositoryUrl,
  featured = false,
} = Astro.props;

const categoryLabel: Record<string, string> = {
  independent: 'Independent',
  'professional-case-study': 'Case Study',
  experiment: 'Experiment',
};

const categoryColor: Record<string, string> = {
  independent: 'text-success bg-success/10 border-success/30',
  'professional-case-study': 'text-accent bg-accent/10 border-accent/30',
  experiment: 'text-warning bg-warning/10 border-warning/30',
};
---

<article
  class="group relative flex flex-col bg-surface border border-border rounded-lg p-6 hover:border-border/80 hover:bg-surface-raised transition-all duration-200"
  class:list={[featured && 'ring-1 ring-accent/20']}
>
  <!-- Header -->
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="text-base font-semibold text-text leading-snug">
      {slug ? (
        <a href={`/projects/${slug}`} class="no-underline hover:text-accent transition-colors duration-150 stretched-link">
          {title}
        </a>
      ) : (
        title
      )}
    </h3>
    <span class={`shrink-0 text-[0.6rem] font-mono font-medium border rounded px-2 py-0.5 leading-none ${categoryColor[category] ?? 'text-muted border-border'}`}>
      {categoryLabel[category] ?? category}
    </span>
  </div>

  <!-- Description -->
  <p class="text-muted text-sm leading-relaxed flex-1 mb-5">
    {description}
  </p>

  <!-- Tech tags -->
  <div class="mb-5">
    <TagList tags={technologies} />
  </div>

  <!-- Links -->
  <div class="flex items-center gap-4 mt-auto pt-4 border-t border-border">
    {slug && (
      <a
        href={`/projects/${slug}`}
        class="text-xs text-accent hover:text-accent-hover no-underline font-medium transition-colors duration-150"
      >
        Read case study →
      </a>
    )}
    {demoUrl && (
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-muted hover:text-text no-underline transition-colors duration-150"
      >
        Live demo ↗
      </a>
    )}
    {repositoryUrl && (
      <a
        href={repositoryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-muted hover:text-text no-underline transition-colors duration-150"
      >
        Repository ↗
      </a>
    )}
  </div>
</article>
