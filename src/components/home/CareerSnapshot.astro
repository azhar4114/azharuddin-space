---
// src/components/home/CareerSnapshot.astro
import { publicExperience } from '../../data/experience';

const roles = publicExperience.map((role) => ({
  employer: role.employer,
  client: role.client,
  role: role.role,
  period: role.periodLabel,
  current: role.endDate === null,
}));
---

<section class="py-20 sm:py-24 border-t border-border">
  <div class="container-content">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <p class="text-eyebrow mb-3">Track Record</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-text tracking-tight mb-4">
          Professional background
        </h2>
        <p class="text-muted text-base leading-relaxed mb-6">
          Hands-on software engineering and technical architecture experience since December 2012,
          focused on enterprise observability (Splunk Enterprise), Python backend microservices,
          workflow architecture (Pega Platform 8.8.3, CSSA certified), and developer automation tools.
        </p>
        <div class="flex flex-col gap-3">
          <a
            href="/experience"
            class="text-sm text-accent hover:text-accent-hover no-underline font-medium transition-colors duration-150 inline-flex items-center gap-1.5"
          >
            Explore career timeline & metrics →
          </a>
          <a
            href="/resume"
            class="text-sm text-subtle hover:text-muted no-underline font-medium transition-colors duration-150 inline-flex items-center gap-1.5"
          >
            View executive resume →
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-0">
        {roles.map((role, i) => (
          <div class="relative flex gap-5 pb-8 last:pb-0">
            <!-- Timeline line -->
            {i < roles.length - 1 && (
              <div class="absolute left-[11px] top-6 bottom-0 w-px bg-border" aria-hidden="true" />
            )}

            <!-- Dot -->
            <div class="relative mt-1 shrink-0">
              <div
                class={`w-5 h-5 rounded-full border-2 flex items-center justify-center ${role.current ? 'border-accent bg-accent/20' : 'border-border bg-surface'}`}
              >
                {role.current && (
                  <div class="w-2 h-2 rounded-full bg-accent" aria-label="Current role" />
                )}
              </div>
            </div>

            <!-- Content -->
            <div>
              <div class="flex items-center gap-2 flex-wrap mb-0.5">
                <span class="text-sm font-semibold text-text">{role.role}</span>
                {role.current && (
                  <span class="text-[0.6rem] font-mono font-medium text-success bg-success/10 border border-success/30 rounded px-1.5 py-0.5 leading-none">
                    Current
                  </span>
                )}
              </div>
              <p class="text-sm text-muted">
                {role.employer}
                {role.client && <span class="text-subtle font-normal"> · {role.client}</span>}
              </p>
              <p class="text-xs font-mono text-subtle mt-0.5">{role.period}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
